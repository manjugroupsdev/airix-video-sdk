{
  "name": "airix-video-react",
  "version": "0.1.4",
  "description": "React hooks and components for AIRIX realtime video.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && vite build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "airix-video-core": "0.1.4"
  },
  "peerDependencies": {
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "livekit-client": "^2.20.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@livekit/components-react": "2.9.21",
    "@livekit/components-styles": "1.2.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "livekit-client": "2.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3"
  }
}
